# ── QUO VOIP API ──────────────────────────────────────────────────────────────
QUO_API_KEY=your_quo_api_key_here
QUO_API_SECRET=your_quo_api_secret_here          # optional – used for HMAC signing
QUO_BASE_URL=https://api.quo.voip/v1
QUO_ACCOUNT_ID=acct_your_account_id              # optional

# ── HTTP tuning ────────────────────────────────────────────────────────────────
QUO_TIMEOUT=30
QUO_MAX_RETRIES=3
QUO_RETRY_BACKOFF=1.5

# ── Claude / Anthropic (for claude_integration.py) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ── Webhook server ────────────────────────────────────────────────────────────
QUO_WEBHOOK_HOST=0.0.0.0
QUO_WEBHOOK_PORT=8080
QUO_WEBHOOK_SECRET=your_webhook_signing_secret   # optional but recommended

# ── Cache ──────────────────────────────────────────────────────────────────────
QUO_ENABLE_CACHE=true
QUO_CACHE_TTL=300                                # seconds
