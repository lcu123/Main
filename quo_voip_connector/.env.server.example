# ── QUO VOIP Remote MCP Server — Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# Add these same variables to your Render service's Environment tab.

# ── Required ──────────────────────────────────────────────────────────────────

# Your QUO VOIP API key (from your QUO dashboard)
QUO_API_KEY=your_quo_api_key_here

# Secret token that every laptop uses to authenticate with this server.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
QUO_SERVER_TOKEN=generate_a_strong_random_token_here

# ── Optional ──────────────────────────────────────────────────────────────────

# QUO VOIP API base URL (default shown)
QUO_BASE_URL=https://api.quo.voip/v1

# Your QUO account ID (sent as X-QUO-Account-ID header)
# QUO_ACCOUNT_ID=acct_your_account_id

# QUO API secret for HMAC-signed write operations
# QUO_API_SECRET=your_api_secret_here

# HTTP timeout in seconds (default: 30)
# QUO_TIMEOUT=30

# Cache TTL in seconds (default: 300)
# QUO_CACHE_TTL=300

# Port (Render sets this automatically — only override for local dev)
# PORT=8000
