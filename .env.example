# Copy to .env for local runs, or paste into Railway -> Variables.
# Only FR_AUTH_KEY, FR_AUTH_TOKEN and FR_SUBDOMAIN (or FR_BASE_URL) are required.

# --- FieldRoutes credentials (Admin -> API -> Manage Keys) -------------------
FR_AUTH_KEY=
FR_AUTH_TOKEN=

# Tenant host. Usually the subdomain you log in at: https://<FR_SUBDOMAIN>.fieldroutes.com
FR_SUBDOMAIN=zest
# ...or override the full API base if your office is still on pestroutes.com.
# FR_BASE_URL=https://zest.pestroutes.com/api

# --- Office defaults ------------------------------------------------------------
# Applied to every search unless the call passes its own officeID(s). Find it via health_check / lookups.
FR_OFFICE_ID=
# Employee the API acts as for notes, tasks, cancels and completions (an office user, not a tech).
FR_DEFAULT_EMPLOYEE_ID=
# Note Type used by add_note. Admin -> Preferences -> Note Types; there is no API endpoint that lists these.
FR_DEFAULT_NOTE_TYPE_ID=
# Task Category used by create_task when the call doesn't give one. FieldRoutes requires a category and only
# accepts the office's own (per-office config, no listing endpoint); lookups(kind="task_categories") shows the
# ones in use on existing tasks.
FR_DEFAULT_TASK_CATEGORY_ID=

# --- Safety switches ------------------------------------------------------------
# on (default) or off. off turns every write tool into a read-only deployment.
FR_WRITES=on
# Deletes (*/delete) and real card charges (payment/create with doCharge=1) are blocked unless set to 1.
FR_ALLOW_DELETE=0
FR_ALLOW_CHARGES=0
# Comma-separated customer IDs writes are restricted to. Set this to your test customer while
# validating the deployment (see README first-run checklist); clear it once that's done and you're live.
FR_WRITE_CUSTOMER_IDS=
# FieldRoutes caps an office at 3000 reads and 3000 writes/day, shared with other integrations.
# The server tracks its own usage and refuses new calls at 95% of these to avoid locking the office out.
FR_DAILY_READ_LIMIT=3000
FR_DAILY_WRITE_LIMIT=3000

# --- Generated per-endpoint tools (fr_{entity}_{action}) ---------------------------
# Off by default: the 31 curated tools are ~6.2k tokens of context; all 187 endpoints are roughly 10x that.
# Comma-separated entities to expose, e.g. customer,appointment,subscription
FR_EXPOSE_ENTITIES=
# 1 exposes every entity (overrides FR_EXPOSE_ENTITIES).
FR_EXPOSE_ALL=0
# 1 keeps the full endpoint description in each generated tool instead of a one-liner.
FR_EXPOSE_VERBOSE=0

# --- Hosting -----------------------------------------------------------------------
# http for Railway / claude.ai remote MCP. Leave unset for stdio (Claude Desktop).
MCP_TRANSPORT=http
PORT=8080
# Secret path segment: the MCP URL becomes https://<host>/<MCP_PATH_SECRET>/mcp. Treat it as a password.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_PATH_SECRET=
# Optional second lock for clients that can send headers (Claude Desktop, mcp-remote): Authorization: Bearer <token>.
# claude.ai's connector UI cannot send headers, so leave this empty for claude.ai.
MCP_BEARER_TOKEN=

# Office local time for "today" and default windows (Railway containers default to UTC).
TZ=America/Los_Angeles

# ====================================================================================
# Zest Visit Video server (`zest-video`, src/zest_video). A second Railway service built
# from this same repo. It reuses FR_AUTH_KEY / FR_AUTH_TOKEN / FR_SUBDOMAIN / FR_OFFICE_ID /
# FR_DEFAULT_EMPLOYEE_ID / FR_DEFAULT_NOTE_TYPE_ID / FR_WRITES / FR_WRITE_CUSTOMER_IDS / TZ
# from above. See docs/video/README.md.
# ====================================================================================

# Public origin of the video server. Every emailed link is built from it. No trailing slash.
VIDEO_BASE_URL=https://video.example.com
# Postgres. On Railway: ${{Postgres.DATABASE_URL}}. (DATABASE_URL is read too.)
VIDEO_DATABASE_URL=
# Long random value; signs the office page's form tokens.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VIDEO_SECRET=
# Office users who are always owners (comma-separated emails). They sign in with an emailed code.
VIDEO_OWNER_EMAILS=

# --- Private video bucket (S3-compatible). On Railway, reference the bucket's variables. ---
VIDEO_S3_ENDPOINT=
VIDEO_S3_BUCKET=
VIDEO_S3_REGION=auto
VIDEO_S3_ACCESS_KEY_ID=
VIDEO_S3_SECRET_ACCESS_KEY=
# 1 only for older buckets whose credentials tab says path-style URLs.
VIDEO_S3_PATH_STYLE=0

# --- Customer email: OFF until you say so --------------------------------------------
# off  = videos are saved and links work, but no customer is emailed (default)
# test = every customer email goes to VIDEO_EMAIL_TEST_TO instead of the customer
# live = customers get their email
VIDEO_EMAIL_MODE=off
VIDEO_EMAIL_TEST_TO=
# Optional extra lock: only these customer IDs are ever emailed (comma-separated).
VIDEO_EMAIL_CUSTOMER_IDS=

# --- Email sender (Resend). Needs SPF + DKIM records on the sending domain. -----------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
VIDEO_MAIL_FROM=Zest Lawn & Pest <video@example.com>
# Where customer replies land (the office inbox).
VIDEO_MAIL_REPLY_TO=
# Leave unset to use Resend when RESEND_API_KEY is set. `log` prints emails (login codes
# included) to the server log instead of sending: first-run testing only.
VIDEO_MAIL_BACKEND=

# --- Login codes by text (Quo, formerly OpenPhone). Optional; email always works. -----
QUO_API_KEY=
QUO_FROM_NUMBER=

# --- Push nudges (APNs .p8 key from the Apple Developer account). Optional. -----------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.zestlawnpest.video
# The .p8 file's contents; newlines may be written as \n.
APNS_KEY_P8=

# --- App Review demo sign-in. Set both to give Apple's reviewer a sandbox account. ----
# The contact is a made-up mobile number (a 555-01xx one) or an email; nothing is ever sent to it.
# The code is 6 digits and fixed. This account sees sample stops only.
VIDEO_DEMO_CONTACT=
VIDEO_DEMO_CODE=

# --- Words on pages and emails --------------------------------------------------------
VIDEO_BRAND_NAME=Zest Lawn & Pest
# Office main line, shown as "Call our office" (E.164, e.g. +19165550100).
VIDEO_OFFICE_PHONE=
# Shown on the privacy and support pages.
VIDEO_PRIVACY_CONTACT=
# The app's App Store page, once it has one (the "please update" screen links to it).
VIDEO_APP_STORE_URL=
# Task Category ID for "tech recommended something" follow-ups (falls back to FR_DEFAULT_TASK_CATEGORY_ID).
VIDEO_SALES_TASK_CATEGORY_ID=
