# Copy to .env for local runs, or paste into Railway -> Variables.
# Only FR_AUTH_KEY, FR_AUTH_TOKEN and FR_SUBDOMAIN (or FR_BASE_URL) are required.

# --- FieldRoutes credentials (Admin -> API -> Manage Keys) -------------------
FR_AUTH_KEY=
FR_AUTH_TOKEN=

# Tenant host. Usually the subdomain you log in at: https://<FR_SUBDOMAIN>.fieldroutes.com
FR_SUBDOMAIN=zest
# ...or override the full API base if your office is still on pestroutes.com.
# FR_BASE_URL=https://zest.pestroutes.com/api

# --- Office defaults ------------------------------------------------------------
# Applied to every search unless the call passes its own officeID(s). Find it via health_check / lookups.
FR_OFFICE_ID=
# Employee the API acts as for notes, tasks, cancels and completions (an office user, not a tech).
FR_DEFAULT_EMPLOYEE_ID=
# Note Type used by add_note. Admin -> Preferences -> Note Types; there is no API endpoint that lists these.
FR_DEFAULT_NOTE_TYPE_ID=

# --- Safety switches ------------------------------------------------------------
# on (default) or off. off turns every write tool into a read-only deployment.
FR_WRITES=on
# Deletes (*/delete) and real card charges (payment/create with doCharge=1) are blocked unless set to 1.
FR_ALLOW_DELETE=0
FR_ALLOW_CHARGES=0
# Comma-separated customer IDs writes are restricted to. Set this to your test customer while
# validating the deployment (see README first-run checklist); clear it once that's done and you're live.
FR_WRITE_CUSTOMER_IDS=
# FieldRoutes caps an office at 3000 reads and 3000 writes/day, shared with other integrations.
# The server tracks its own usage and refuses new calls at 95% of these to avoid locking the office out.
FR_DAILY_READ_LIMIT=3000
FR_DAILY_WRITE_LIMIT=3000

# --- Generated per-endpoint tools (fr_{entity}_{action}) ---------------------------
# Off by default: the 30 curated tools are ~2.5k tokens of context; all 187 endpoints are ~70k.
# Comma-separated entities to expose, e.g. customer,appointment,subscription
FR_EXPOSE_ENTITIES=
# 1 exposes every entity (overrides FR_EXPOSE_ENTITIES).
FR_EXPOSE_ALL=0
# 1 keeps the full endpoint description in each generated tool instead of a one-liner.
FR_EXPOSE_VERBOSE=0

# --- Hosting -----------------------------------------------------------------------
# http for Railway / claude.ai remote MCP. Leave unset for stdio (Claude Desktop).
MCP_TRANSPORT=http
PORT=8080
# Secret path segment: the MCP URL becomes https://<host>/<MCP_PATH_SECRET>/mcp. Treat it as a password.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_PATH_SECRET=
# Optional second lock for clients that can send headers (Claude Desktop, mcp-remote): Authorization: Bearer <token>.
# claude.ai's connector UI cannot send headers, so leave this empty for claude.ai.
MCP_BEARER_TOKEN=

# Office local time for "today" and default windows (Railway containers default to UTC).
TZ=America/Los_Angeles
