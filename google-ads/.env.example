# Google Ads MCP (google-ads/) — paste into Railway -> google-ads-mcp -> Variables.
# Only the three secrets are required; everything else is derived or optional.

# --- Required ---------------------------------------------------------------------
# Google Cloud -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (type: Web application).
# Authorized redirect URI must be exactly:  https://<railway-domain>/auth/callback
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
# Google Ads -> (manager account) -> Admin -> API Center. Needs at least Explorer/Basic access
# to read a production account; a token approved only for test accounts returns an error.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Optional ---------------------------------------------------------------------
# If the account is reached through a manager (MCC) account, its 10-digit customer ID (no dashes).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Public URL of this service. Defaults to https://$RAILWAY_PUBLIC_DOMAIN, which Railway injects.
GOOGLE_ADS_MCP_BASE_URL=
# Generated once on the volume when unset. Set explicitly if you run more than one replica.
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=
# OAuth state storage (Dockerfile default: filetree at /var/lib/google-ads-mcp — mount a volume there).
GOOGLE_ADS_MCP_STORAGE_TYPE=filetree
GOOGLE_ADS_MCP_STORAGE_PATH=/var/lib/google-ads-mcp
